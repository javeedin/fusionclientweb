# MCP Bridge Configuration

# Server port
PORT=3001

# Environment mode
NODE_ENV=development

# Logging level (debug, info, warn, error)
LOG_LEVEL=debug

# Tool execution timeout in milliseconds
MCP_BRIDGE_TIMEOUT=30000

# Allowed MCP servers (comma-separated, optional)
# Leave empty to allow all servers
ALLOWED_SERVERS=https://mcp.kite.trade/mcp

# Enable CORS for specific origins (comma-separated)
# Leave empty for localhost only
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ═══════════════════════════════════════════════════════════════════
# Zerodha Kite Connect OAuth Configuration
# ═══════════════════════════════════════════════════════════════════
# Get these from: https://kite.trade/apps/api_console
# 1. Go to Kite API Console
# 2. Create an app (or use existing one)
# 3. Copy API Key and API Secret

# Zerodha API Key (public key for OAuth flow)
ZERODHA_API_KEY=your_api_key_here

# Zerodha API Secret (private key for token exchange)
ZERODHA_API_SECRET=your_api_secret_here

# Redirect URL after OAuth login (where user returns after Zerodha login)
# In development: http://localhost:3001/api/auth/zerodha/callback
# In production: https://your-domain.com/api/auth/zerodha/callback
ZERODHA_REDIRECT_URL=http://localhost:3001/api/auth/zerodha/callback

# Autopilot URL (for OAuth success/failure redirects)
# In development: http://localhost:3000
# In production: https://your-app-domain.com
AUTOPILOT_URL=http://localhost:3000
