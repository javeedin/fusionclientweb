# MCP Bridge Configuration

# Server port
PORT=3001

# Environment mode
NODE_ENV=development

# Logging level (debug, info, warn, error)
LOG_LEVEL=debug

# Tool execution timeout in milliseconds
MCP_BRIDGE_TIMEOUT=30000

# Allowed MCP servers (comma-separated, optional)
# Leave empty to allow all servers
ALLOWED_SERVERS=https://mcp.kite.trade/mcp

# Enable CORS for specific origins (comma-separated)
# Leave empty for localhost only
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
