# ═════════════════════════════════════════════════════════════
# FusionClientWeb - Environment Configuration
# ═════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your values

# ─────────────────────────────────────────────────────────────
# Company Selection
# ─────────────────────────────────────────────────────────────
REACT_APP_COMPANY=BUIMERC

# ─────────────────────────────────────────────────────────────
# BUIMERC - Oracle Cloud Instance
# ─────────────────────────────────────────────────────────────
REACT_APP_BUIMERC_APEX_BASE_URL=https://g15d6279501ae08-buimerc.adb.me-dubai-1.oraclecloudapps.com/ords/bcldifc/reerp
REACT_APP_BUIMERC_FUSION_BASE_URL=https://iaaobn.fa.ocs.oraclecloud.com/fscmRestApi/resources/11.13.18.05
REACT_APP_BUIMERC_HCM_BASE_URL=https://iaaobn-test.fa.ocs.oraclecloud.com/hcmRestApi/resources/11.13.18.05
REACT_APP_BUIMERC_FUSION_USER=your_bumeric_fusion_username
REACT_APP_BUIMERC_FUSION_PASSWORD=your_bumeric_fusion_password

# ─────────────────────────────────────────────────────────────
# GRAYS INC - Oracle Cloud Instance
# ─────────────────────────────────────────────────────────────
REACT_APP_GRAYSINC_APEX_BASE_URL=https://[TBD].adb.em3.oraclecloudapps.com/ords/...
REACT_APP_GRAYSINC_FUSION_BASE_URL=https://efmh-test.fa.em3.oraclecloud.com/fscmRestApi/resources/11.13.18.05
REACT_APP_GRAYSINC_HCM_BASE_URL=https://efmh-test.fa.em3.oraclecloud.com/hcmRestApi/resources/11.13.18.05
REACT_APP_GRAYSINC_FUSION_USER=your_graysinc_fusion_username
REACT_APP_GRAYSINC_FUSION_PASSWORD=your_graysinc_fusion_password

# ─────────────────────────────────────────────────────────────
# Vercel Proxy (for production)
# ─────────────────────────────────────────────────────────────
# These are set automatically in Vercel dashboard
# But you can override locally if needed:
# REACT_APP_VERCEL_URL=your-vercel-app.vercel.app

# ─────────────────────────────────────────────────────────────
# MCP Bridge Server Configuration
# ─────────────────────────────────────────────────────────────
# URL of the MCP Bridge service (for MCP tool integration with Claude)
# In development: http://localhost:3001
# In production: https://your-mcp-bridge-domain.com
REACT_APP_MCP_BRIDGE_URL=http://localhost:3001

# ─────────────────────────────────────────────────────────────
# Build & Development
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
VITE_DEBUG=false
