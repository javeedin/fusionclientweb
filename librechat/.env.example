# ── LibreChat .env — copy to .env and fill in ───────────────────────────────
# NEVER commit the real .env (it holds live keys).

# Port the LibreChat UI listens on (also update VITE_LIBRECHAT_URL if changed)
PORT=3080

# ── Anthropic (Claude) ──────────────────────────────────────────────────────
# Paste your real key (sk-ant-...), or set to user_provided so each LibreChat
# user enters their own key under Settings → API keys.
ANTHROPIC_API_KEY=user_provided

# Restrict LibreChat to the Anthropic endpoint only
ENDPOINTS=anthropic

# ── Oracle GL MCP server (passed through librechat.yaml) ────────────────────
ORACLE_BASE_URL=https://g15d6279501ae08-buimerc.adb.me-dubai-1.oraclecloudapps.com
ORACLE_USERNAME=
ORACLE_PASSWORD=
# Set to 1 to skip ORDS token auth (only if the endpoints are open)
SKIP_AUTH=1

# ── LibreChat security secrets — REGENERATE THESE ───────────────────────────
# CREDS_KEY:          openssl rand -hex 32
# CREDS_IV:           openssl rand -hex 16
# JWT_SECRET:         openssl rand -hex 32
# JWT_REFRESH_SECRET: openssl rand -hex 32
CREDS_KEY=replace_with_openssl_rand_hex_32
CREDS_IV=replace_with_openssl_rand_hex_16
JWT_SECRET=replace_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=replace_with_openssl_rand_hex_32

# ── Registration ────────────────────────────────────────────────────────────
# Allow creating local accounts on first run; disable after your team signed up.
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false

# ── Misc ────────────────────────────────────────────────────────────────────
APP_TITLE=Oracle ERP Assistant
NO_INDEX=true
SEARCH=false
