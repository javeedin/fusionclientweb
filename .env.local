# ─────────────────────────────────────────────────────────────
# Company Selection
# ─────────────────────────────────────────────────────────────
REACT_APP_COMPANY=BUIMERC
REACT_APP_DEFAULT_COMPANY=BUIMERC
REACT_APP_DISABLE_COMPANY_SELECTION=yes

# ─────────────────────────────────────────────────────────────
# BUIMERC - Oracle Cloud Instance
# ─────────────────────────────────────────────────────────────
REACT_APP_BUIMERC_APEX_BASE_URL=https://g15d6279501ae08-buimerc.adb.me-dubai-1.oraclecloudapps.com/ords/bcldifc/reerp
REACT_APP_BUIMERC_FUSION_BASE_URL=https://iaaobn-test.fa.ocs.oraclecloud.com
# BUIMERC - No Fusion instances configured (uses APEX login instead)
REACT_APP_BUIMERC_FUSION_INSTANCES=[]
REACT_APP_BUIMERC_HCM_BASE_URL=https://iaaobn-test.fa.ocs.oraclecloud.com/hcmRestApi/resources/11.13.18.05

# ─────────────────────────────────────────────────────────────
# MITSUMI - Oracle Cloud Instance
# ─────────────────────────────────────────────────────────────
