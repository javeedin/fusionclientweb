# ═════════════════════════════════════════════════════════════
# FusionClientWeb - Environment Configuration
# ═════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────
# Company Selection
# ─────────────────────────────────────────────────────────────
REACT_APP_COMPANY=BUIMERC
REACT_APP_DEFAULT_COMPANY=BUIMERC
REACT_APP_DISABLE_COMPANY_SELECTION=no

# ─────────────────────────────────────────────────────────────
# ORDS OAuth2 token security (REERP + reerp.sla modules)
# YES = every APEX/ORDS call carries "Authorization: Bearer <token>"
# NO  = no token logic at all (current behavior)
# Flip to YES only after rebuild; protect the modules in ORDS last.
# ─────────────────────────────────────────────────────────────
REACT_APP_ORDS_USE_TOKEN=YES
REACT_APP_ORDS_CLIENT_ID=Iv1jm-smiA-fNVNiDYDSyQ..
REACT_APP_ORDS_CLIENT_SECRET=JZA6w4fMO2SF9F5Iclogbg..

# ─────────────────────────────────────────────────────────────
# BUIMERC - Oracle Cloud Instance
# ─────────────────────────────────────────────────────────────
REACT_APP_BUIMERC_APEX_BASE_URL=https://g15d6279501ae08-buimerc.adb.me-dubai-1.oraclecloudapps.com/ords/bcldifc/reerp
REACT_APP_BUIMERC_FUSION_BASE_URL=https://iaaobn-test.fa.ocs.oraclecloud.com
# BUIMERC - No Fusion instances configured (uses APEX login instead)
REACT_APP_BUIMERC_FUSION_INSTANCES=[]
REACT_APP_BUIMERC_HCM_BASE_URL=https://iaaobn-test.fa.ocs.oraclecloud.com/hcmRestApi/resources/11.13.18.05

# ─────────────────────────────────────────────────────────────
# GRAYS INC - Oracle Cloud Instance
# ─────────────────────────────────────────────────────────────
REACT_APP_GRAYSINC_APEX_BASE_URL=https://g09254cbbf8e7af-graysprod.adb.eu-frankfurt-1.oraclecloudapps.com
REACT_APP_GRAYSINC_FUSION_BASE_URL=https://efmh.fa.em3.oraclecloud.com
# GRAYS INC Fusion Instances - user enters credentials at login
REACT_APP_GRAYSINC_FUSION_INSTANCES=[{"name":"Production","url":"https://efmh.fa.em3.oraclecloud.com"},{"name":"Test","url":"https://efmh-test.fa.em3.oraclecloud.com"}]
REACT_APP_GRAYSINC_HCM_BASE_URL=https://efmh.fa.em3.oraclecloud.com/hcmRestApi/resources/11.13.18.05

# ─────────────────────────────────────────────────────────────
# Vercel Proxy (for production)
# ─────────────────────────────────────────────────────────────
# These are set automatically in Vercel dashboard
# But you can override locally if needed:
# REACT_APP_VERCEL_URL=your-vercel-app.vercel.app

# ─────────────────────────────────────────────────────────────
# Build & Development
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
VITE_DEBUG=false
